{
  "name": "desk-setup-switcher-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/verify-release-publication.mjs && NEXT_PUBLIC_SITE_URL=http://localhost:3000 WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "node scripts/verify-release-publication.mjs && node --env-file-if-exists=.env.local scripts/verify-site-origin.mjs && WRANGLER_LOG_PATH=.wrangler/wrangler.log node --env-file-if-exists=.env.local node_modules/vinext/dist/cli.js build",
    "build:local": "ALLOW_LOCAL_SITE_ORIGIN=1 NEXT_PUBLIC_SITE_URL=http://localhost:3000 NEXT_PUBLIC_RELEASE_FIXTURE= npm run build",
    "build:test-holding": "ALLOW_LOCAL_SITE_ORIGIN=1 NEXT_PUBLIC_SITE_URL=http://localhost:3000 NEXT_PUBLIC_RELEASE_FIXTURE=holding npm run build",
    "build:test-published": "ALLOW_LOCAL_SITE_ORIGIN=1 NEXT_PUBLIC_SITE_URL=http://localhost:3000 NEXT_PUBLIC_RELEASE_FIXTURE=published npm run build",
    "build:private-preview": "node scripts/build-private-preview.mjs",
    "build:pages": "node scripts/build-github-pages.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "EXPECTED_RELEASE_STATE=current node --test tests/rendered-html.test.mjs",
    "test:holding": "EXPECTED_RELEASE_STATE=holding node --test tests/rendered-html.test.mjs",
    "test:published": "EXPECTED_RELEASE_STATE=published node --test tests/rendered-html.test.mjs",
    "test:private-preview": "EXPECTED_RELEASE_STATE=current EXPECTED_SITE_AUDIENCE=private node --test tests/rendered-html.test.mjs",
    "test:pages": "node --test tests/github-pages-export.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "audit:dependencies": "npm audit",
    "verify": "node scripts/verify-site.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.69.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitejs/plugin-rsc": "0.5.37",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "react-server-dom-webpack": "19.3.1",
    "typescript": "5.9.3",
    "vinext": "1.4.5",
    "vite": "8.3.8",
    "wrangler": "4.161.0",
    "miniflare": "5.20261110.0-beta"
  },
  "overrides": {
    "postcss": "8.5.32",
    "sharp": "0.35.5",
    "undici": "7.30.1",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    },
    "satori": {
      "fflate": "0.7.5"
    }
  },
  "type": "module"
}
